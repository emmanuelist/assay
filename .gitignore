# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the example is committed on purpose, real ones never are
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local render captures and demo build output (regenerate with npm run film:all)
.playwright-mcp/
/*.png
film/
# the delivered demo ships with the site
!public/assay-demo.mp4
!public/assay-poster.jpg

# python bytecode and regenerable recon output
__pycache__/
recon/audit.json

# regenerated by the framework on every dev run
AGENTS.md

# private competitive brief and review spec, kept local
see.md
check.md

.env.vercel

agents.registered.json

sessions.granted.json

sessions.keys.json
